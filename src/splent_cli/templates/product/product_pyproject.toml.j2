[build-system]
requires = ["setuptools>=80.3.1", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ product_name }}"
version = "0.0.1"
description = "{{ product_name }} is an app built with SPLENT (https://www.splent.io)"
readme = "README.md"
requires-python = ">=3.13"

dependencies = [

]

[project.optional-dependencies]
dev = [
    "watchdog",
    "locust"
]

core = [
    "splent_framework"
]

[tool.splent]
cli_version = "{{ cli_version }}"

# Features active in all environments
features = []

# Features active only in dev (e.g. debug tools, fake data generators)
features_dev = []

# Features active only in prod (e.g. monitoring, caching)
features_prod = []

# SPL reference. The product derives from this SPL's feature model (UVL).
# The model is not stored inside the product; it is resolved from the working
# copy at splent_spl_<name>/, then from .splent_cache/spls/, then downloaded.
spl = "{{ spl_name }}"

# Where the SPL model itself comes from. The name above is not enough to
# download anything, so the DOI travels with the product and any clone of this
# repository can resolve the model from UVLHub alone, with no catalog and no
# marketplace in the way.
[tool.splent.spl_model]
mirror = "{{ spl_mirror | default('uvlhub.io') }}"
doi = "{{ spl_doi | default('') }}"
# Same line, every version. Used to report that a newer model exists.
concept_doi = "{{ spl_concept_doi | default('') }}"
version = "{{ spl_version | default('') }}"
{%- if spl_file %}
# The model's filename on UVLHub, which is not always <name>.uvl. Without it
# the download falls back to the SPL name and 404s.
file = "{{ spl_file }}"
{%- endif %}

# Layout hooks declared in base_template.html.
# Features register callbacks to these hooks via register_template_hook().
[tool.splent.layout]
base_template = "base_template.html"
hooks = [
    "layout.head.css",
    "layout.sidebar.top",
    "layout.anonymous_sidebar",
    "layout.authenticated_sidebar",
    "layout.sidebar.authenticated.items",
    "layout.navbar.anonymous",
    "layout.navbar.authenticated",
    "layout.footer",
    "layout.scripts",
]

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]
