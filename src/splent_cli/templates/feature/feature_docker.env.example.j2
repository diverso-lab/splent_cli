# {{ feature_name }} — defaults for the stack in this directory.
#
# product:env --merge copies these into the product's docker/.env, where the
# product may override any of them; a value the product already set is never
# overwritten. Two substitutions happen on the way in:
#
#   *_HOST_PORT      offset by zlib.crc32(<product>) % 1000, so each product
#                    publishes on a port of its own
#   __PRODUCT__      replaced by the product's name
#
# Mark a variable a person is expected to edit with a "# user-tunable"
# comment on the line above it.

# The port this stack publishes on the host. The number here is only the
# base: what any given product ends up with is this plus its own offset.
# Pick something outside the range products use for their web containers.
{{ env_prefix }}_HOST_PORT=CHANGEME

# How the application reaches the service. The hostname is the Compose
# service name, which is also the DNS name on splent_network, and the port is
# the container-side one, not the published one: this connection never leaves
# the network.
{{ env_prefix }}_URL=http://{{ feature_name }}:CHANGEME
