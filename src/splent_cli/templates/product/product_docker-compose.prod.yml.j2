services:

  {{ product_name }}_web_deploy:
    image: {{ product_name }}:latest
    container_name: {{ product_name }}_web_deploy
    env_file:
      - ./.env.deploy
    ports:
      # Host interface for the published web port, taken from
      # SPLENT_WEB_BIND_HOST in .env.deploy (marked user-tunable there, so
      # product:deploy keeps whatever you set). It falls back to 0.0.0.0, all
      # interfaces, when the variable is absent, which matches the historical
      # behaviour. 127.0.0.1 is the right value when a proxy on the host
      # terminates TLS and forwards traffic to loopback.
      - "${SPLENT_WEB_BIND_HOST:-0.0.0.0}:{{ web_port }}:5000"
{% if uploads_volume or protected_uploads_dir or archive_dir %}    volumes:
      # Uploaded and generated files live inside the container and are lost
      # on every redeploy unless they are kept on named volumes.
{% if uploads_volume %}      - {{ product_name }}_web_deploy_uploads:/workspace/{{ product_name }}/src/{{ product_name }}/static/uploads
{% endif %}{% if protected_uploads_dir %}      - {{ product_name }}_web_deploy_protected_uploads:${PROTECTED_UPLOADS_DIR:-{{ protected_uploads_dir }}}
{% endif %}{% if archive_dir %}      - {{ product_name }}_web_deploy_archive:${ARCHIVE_DIR:-{{ archive_dir }}}
{% endif %}{% endif %}    depends_on:
      {{ product_name }}_db_deploy:
        condition: service_healthy
    networks:
      - {{ network_name }}
    command: [ "bash", "-c", "bash /workspace/{{ product_name }}/entrypoints/entrypoint.prod.sh" ]

  {{ product_name }}_db_deploy:
    image: mariadb:11.4
    container_name: {{ product_name }}_db_deploy
    env_file:
      - ./.env.deploy
    command: --default-authentication-plugin=mysql_native_password
    ports:
      # Host interface for the published database port, taken from
      # SPLENT_DB_BIND_HOST in .env.deploy (marked user-tunable there). It
      # falls back to 0.0.0.0 when the variable is absent, matching the
      # historical behaviour. 127.0.0.1 keeps the database reachable from the
      # host itself only. The compose network already connects the web
      # container to it, so the published port is for host-side tooling.
      - "${SPLENT_DB_BIND_HOST:-0.0.0.0}:{{ db_port }}:3306"
    volumes:
      - {{ product_name }}_db_deploy_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mariadb -u$${MARIADB_USER} -p$${MARIADB_PASSWORD} -e 'SELECT 1'"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s
    networks:
      - {{ network_name }}

volumes:
  {{ product_name }}_db_deploy_data:
{% if uploads_volume %}  {{ product_name }}_web_deploy_uploads:
{% endif %}{% if protected_uploads_dir %}  {{ product_name }}_web_deploy_protected_uploads:
{% endif %}{% if archive_dir %}  {{ product_name }}_web_deploy_archive:
{% endif %}
networks:
  {{ network_name }}:
    external: true
