[build-system]
requires = ["setuptools>=80.3.1", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ feature_name }}"
version = "0.0.1"
readme = "README.md"
requires-python = ">=3.13"

dependencies = [

]

[tool.setuptools]
package-dir = { "" = "src" }
include-package-data = true

[tool.setuptools.packages.find]
where = ["src"]
exclude = ["*.tests", "*.tests.*"]

[tool.splent]
cli_version = "{{ cli_version }}"

# ── Feature Contract ──────────────────────────────────────────────────────────
# Declares what this feature provides to and requires from the product.
# Used by `splent feature:check` and `splent product:derive` for validation.
[tool.splent.contract]
description = "{{ short_name }} feature"

[tool.splent.contract.provides]
# Routes exposed by this feature
routes = ["/{{ short_name }}"]
# Blueprint names registered into Flask
blueprints = ["{{ short_name }}_bp"]
# SQLAlchemy models introduced by this feature
models = []
# CLI commands added by this feature
commands = []

[tool.splent.contract.requires]
# Other SPLENT features this feature depends on (e.g. ["auth", "mail"])
features = []
# Environment variables this feature expects to be set
env_vars = []

# ── Extension points ──────────────────────────────────────────────────────────
# Declares what other features can override or extend via refinement.
# See: splent feature:xray
[tool.splent.contract.extensible]
services = []
templates = []
models = []
hooks = []
routes = false

# ── Configuration ─────────────────────────────────────────────────────────────
# What this feature reads from the environment, and what it falls back to.
# One line per variable, the value being the default.
#
# This is where a default belongs, whether or not the feature ships a
# container: docker/.env.example only exists for features that bring a
# service, and a setting is not infrastructure. A product overrides any of
# these in its own [tool.splent.config]; it never copies the ones it agrees
# with. `splent product:env --merge` and `splent product:build` both read
# this, so dev and deploy see the same values.
#
# Types map to what an env file can hold: true becomes "true", a list
# becomes a comma separated string. Keys ending in _HOST_PORT get the
# product's port offset, so two products can run at once.
[tool.splent.config]
# {{ env_prefix }}_EXAMPLE = "value"
